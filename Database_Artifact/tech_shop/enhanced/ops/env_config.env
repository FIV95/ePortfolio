# Tech Repair Shop — Environment & Migration Configuration
# Used by setup_environment.sh, migrate_enhanced.sh, and verify_environment.sh

# Source shared DB settings (host, port, user, PG_BIN_DIR, etc.)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=backup_config.env
source "${SCRIPT_DIR}/backup_config.env"

# Default target for fresh environment provisioning (simulated staging/cloud)
STAGING_DB_NAME=tech_shop_staging

# Repository root (original + enhanced SQL live here)
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"