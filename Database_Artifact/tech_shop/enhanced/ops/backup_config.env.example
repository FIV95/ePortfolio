# Tech Repair Shop — Backup/Restore Configuration
# Copy to backup_config.env and edit for your machine:
#   cp backup_config.env.example backup_config.env

DB_NAME=tech_shop
DB_USER=your_postgres_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
SCHEMA_NAME=tech

# Leave empty to use psql/pg_dump from PATH (Linux, most installs).
# On macOS with Homebrew keg-only PostgreSQL, uncomment and set:
# PG_BIN_DIR=/opt/homebrew/opt/postgresql@17/bin
PG_BIN_DIR=