# Tech Repair Shop — Backup/Restore Configuration
# Source this file from backup_db.sh and restore_db.sh (do not commit secrets)

DB_NAME=tech_shop
DB_USER=fiv
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
SCHEMA_NAME=tech

# Client tools must match the server major version (server is PostgreSQL 17)
PG_BIN_DIR=/opt/homebrew/opt/postgresql@17/bin