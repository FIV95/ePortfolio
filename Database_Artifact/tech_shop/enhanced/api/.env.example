# FastAPI runtime configuration
# Copy to .env and edit for your machine:
#   cp .env.example .env

DB_NAME=tech_shop
DB_USER=your_postgres_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

API_HOST=127.0.0.1
API_PORT=8000